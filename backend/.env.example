# ── Conexión a PostgreSQL: elegir UN destino y comentar los demás ──────────
#
# Usuario, contraseña y nombre de la base salen SIEMPRE de db/.env (única
# fuente, en desarrollo y en producción). DATABASE_SSL viaja tal cual a
# asyncpg. Valores: disable | allow | prefer | require | verify-ca | verify-full
#
# 1) Producción, backend corriendo EN el servidor (compose.prod.yml).
#    Se llega por la red interna de Docker, pero db/pg_hba.conf exige cifrado
#    a toda conexión de red, así que "require" también aquí. El certificado es
#    autofirmado: "require" cifra sin validar la CA, que es lo que toca.
DATABASE_URL=postgresql+asyncpg://cliniventas:CAMBIAR@postgres:5432/cliniventas_db
DATABASE_SSL=require

# 2) Desarrollo en tu laptop apuntando a la base de PRODUCCIÓN.
#    Va por Internet: el servidor exige TLS (pg_hba `hostssl`), así que
#    "require" como mínimo o la conexión se rechaza. ⚠ Son datos reales:
#    cualquier UPDATE/DELETE es inmediato y sin red de seguridad.
# DATABASE_URL=postgresql+asyncpg://cliniventas:CAMBIAR@<IP-del-servidor>:5432/cliniventas_db
# DATABASE_SSL=require

# URLs de los subworkflows n8n invocados a demanda. Usar las URLs de
# producción después de importar, volver a asociar las credenciales y activar
# los exports sanitizados.
N8N_WEBHOOK_URL=
N8N_ANALYST_WEBHOOK_URL=

# Token que el backend presenta a los webhooks de n8n (app -> n8n).
OUTBOUND_WEBHOOK_TOKEN=

# Token que n8n debe enviar como header Authorization: Bearer <token> al llamar POST /api/webhooks/messages
#
# OBLIGATORIO: el backend NO arranca sin él. Es lo único que protege
# /api/webhooks/* y la subida de media, que están expuestos a Internet y
# pueden insertar mensajes y mover etapas de lead (lo que dispara
# automatizaciones y envíos reales de WhatsApp).
#
# Generar con: openssl rand -hex 32
# El mismo valor va configurado en n8n.
INBOUND_WEBHOOK_TOKEN=

# Credenciales de la app de Meta (Tech Provider). Son de la plataforma, no de un
# negocio: las leen el challenge del webhook y la verificación de firma, que
# corren antes de saber a qué tenant pertenece el evento. Con MULTITENANCY_ENABLED
# activo tienen que estar acá, porque `app_settings` vive dentro del schema de
# cada negocio (ver services/platform_settings.py).
META_VERIFY_TOKEN=
META_APP_SECRET=

# Activar solo después de registrar el negocio actual, aprovisionar/mover su
# schema y ejecutar `python -m scripts.migrate --check` sin pendientes.
MULTITENANCY_ENABLED=false
# Hosts del plano de plataforma separados por coma; nunca sirven rutas CRM.
TENANT_PLATFORM_HOSTS=localhost,testserver
# Secreto independiente para firmar jobs RAG/analista. Obligatorio en multi.
# Generar con: openssl rand -hex 32
AI_JOB_SIGNING_SECRET=

# Orígenes permitidos para CORS. Es una lista JSON, no valores separados por
# coma: CORS_ORIGINS=a,b no arranca (pydantic-settings la parsea como JSON).
# CORS_ORIGINS=["http://localhost:5173","https://tudominio.com"]

# ElevenLabs, para convertir a voz las sugerencias de texto y mandarlas como
# nota de audio de WhatsApp. Dejar ELEVENLABS_API_KEY vacío deshabilita
# "Enviar como audio". ELEVENLABS_VOICE_ID trae una voz por default (podés
# cambiarla eligiendo otra en https://elevenlabs.io/app/voice-library).
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_STABILITY=0
# ELEVENLABS_STYLE=1
# ELEVENLABS_SPEED=1.2
# ELEVENLABS_USE_SPEAKER_BOOST=true

# Secreto maestro de la aplicación. También sirve como respaldo para derivar
# la clave de cifrado de app_settings. Generar con: openssl rand -hex 32
SECRET_KEY=

# Marca `Secure` de la cookie de sesión. Sin valor se deduce del esquema real
# de la petición (incluyendo el X-Forwarded-Proto que pone Traefik). Ponerlo
# en true la fuerza, que es lo correcto en cualquier despliegue con HTTPS.
# COOKIE_SECURE=true

# Sesiones persistentes: 30 días de inactividad y 90 días como máximo.
# Los tokens se rotan cada 24 h y se guardan sólo como hash en PostgreSQL.
# SESSION_IDLE_HOURS=720
# SESSION_ABSOLUTE_HOURS=2160
# SESSION_ROTATION_HOURS=24
# TRUSTED_DEVICE_EXPIRE_HOURS=2160
# PIN_MAX_ATTEMPTS=5
# PIN_LOCK_MINUTES=15

# Clave maestra para cifrar tokens y API keys guardados en app_settings.
# Generar una vez, respaldarla fuera de la DB y no cambiarla sin rotación:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Si se omite, el backend deriva temporalmente una clave de SECRET_KEY.
SETTINGS_ENCRYPTION_KEY=

# Se usan una única vez, para crear el primer usuario admin cuando la tabla
# `users` está vacía. Después de loguearte por primera vez podés borrar estas
# dos líneas (ya no se vuelven a leer si existe algún usuario).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Almacenamiento multimedia: "minio" en producción.
#
# Con "local" los archivos van a backend/media DENTRO del contenedor. En
# blue-green cada despliegue levanta un contenedor nuevo, así que todo lo
# subido desaparece salvo que esa ruta esté montada desde el host —
# compose.prod.yml monta ./data/media justamente para eso. "local" sirve para
# desarrollo; el backend avisa por log si arranca así.
#
# MINIO_ENDPOINT es host[:puerto], sin http:// ni https://, y debe apuntar a
# la API S3 de MinIO (normalmente 9000), no a la consola administrativa.
# Las credenciales las genera scripts/minio-setup.sh.
MEDIA_STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio-api.tudominio.com:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Un bucket para toda la plataforma; los negocios se separan por carpeta, no
# por bucket (crear uno por cliente obligaría a credenciales y políticas nuevas
# en cada alta).
MINIO_BUCKET=cliniventas
MINIO_REGION=us-east-1
MINIO_SECURE=true
MINIO_VERIFY_TLS=true
# Timeouts del cliente. El de lectura es por trozo recibido, no total, así que
# no corta descargas grandes que sigan avanzando.
MINIO_CONNECT_TIMEOUT_SECONDS=5
MINIO_READ_TIMEOUT_SECONDS=30
# Vacío a propósito: las claves ya empiezan por `tenants/<uuid>-<nombre>/`, que
# arma el backend con el contexto del negocio (ver services/media_storage.py).
# Objetos resultantes:
#   tenants/21675109-...-dermicapro/images/*
#   tenants/21675109-...-dermicapro/audio/*   (idem video/ y files/)
# El nombre en la carpeta es solo para reconocer el negocio en la consola de
# MinIO: se fija al aprovisionar (organizations.storage_prefix) y no cambia si
# después renombran el negocio.
MINIO_PREFIX=
