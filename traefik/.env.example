# Correo usado por Let's Encrypt para el registro ACME y avisos de expiración
ACME_EMAIL=postmaster@tudominio.com

# Token de API de Hostinger (hPanel), necesario solo si el resolver usa el
# desafío DNS-01 — ver reverse-proxy.docker-compose.yml. Es lo que permite
# emitir el wildcard `*.cliniventas.com` que cubre a todos los negocios; con
# HTTP-01 no hace falta, pero entonces se emite un certificado por subdominio.
HOSTINGER_API_TOKEN=
