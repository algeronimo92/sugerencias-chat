# Correo usado por Let's Encrypt para el registro ACME y avisos de expiración
ACME_EMAIL=postmaster@tudominio.com

# Token de API de Hostinger (hPanel). Obligatorio: el resolver usa el desafío
# DNS-01 (ver reverse-proxy.docker-compose.yml) y sin él no se emite el
# wildcard `*.cliniventas.com` que cubre a todos los negocios. El despliegue
# se niega a seguir si está vacío.
HOSTINGER_API_TOKEN=
