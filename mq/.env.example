# Copiar a mq/.env en el servidor y rellenar. mq/.env NO se versiona.
#
#   cp mq/.env.example mq/.env
#   openssl rand -hex 24     # una contraseña distinta para cada usuario

# IP de este host DENTRO del túnel WireGuard (ver docs/red-privada-wireguard.md).
# Es por donde entran Evolution y n8n. Nunca 0.0.0.0.
RABBITMQ_BIND_IP=10.10.0.1

# Vhost donde vive toda la topología. Si se cambia, hay que cambiarlo también
# en mq/definitions.json y en las credenciales de n8n y Evolution.
RABBITMQ_VHOST=dermicapro

# Administrador: el único con acceso a la consola (127.0.0.1:15672 por túnel SSH).
# No lo usa ningún servicio.
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=

# Credenciales por servicio, con permisos mínimos (ver mq/provision.sh).
# La de Evolution sólo publica; la de n8n sólo consume la cola de entrada.
RABBITMQ_EVOLUTION_PASSWORD=
RABBITMQ_N8N_PASSWORD=
