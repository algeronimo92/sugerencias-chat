# Credenciales del PostgreSQL del proyecto (docker-compose.db.yml).
# Copiar a db/.env y poner una contraseña real:
#   openssl rand -base64 32
POSTGRES_DB=dermicapro_db
POSTGRES_USER=dermicapro
POSTGRES_PASSWORD=

# Días que se conservan los backups (scripts/db-backup.sh)
# BACKUP_KEEP_DAYS=14

# Camino para que n8n (que corre en otra VPS) alcance esta base. OBLIGATORIA:
# compose.db.yml aborta si falta, y tampoco acepta 127.0.0.1 (chocaría con la
# publicación en loopback que hace siempre, para postgres_exporter y
# scripts/db-backup.sh). Si nadie tiene que entrar desde afuera, la salida no
# es buscarle un valor: es borrar esa línea de `ports` en compose.db.yml.
#
# Debe ser la IP PRIVADA de este host, nunca 0.0.0.0: atado a todas las
# interfaces el puerto queda expuesto a Internet.
#
# Averiguarla en el servidor con:  ip -4 addr show | grep "inet 10\.\|inet 172\.\|inet 192\.168\."
POSTGRES_BIND_IP=10.0.0.5
# POSTGRES_PUBLISH_PORT=5432

# El TLS no se configura aquí: compose.db.yml arranca con ssl=on siempre y
# db/pg_hba.conf rechaza toda conexión de red sin cifrar. Lo único que hace
# falta es el certificado, que genera scripts/gen-db-tls.sh en db/tls/.
# Sin él la base no levanta.
