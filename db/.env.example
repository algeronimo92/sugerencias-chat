# Credenciales del PostgreSQL del proyecto (docker-compose.db.yml).
# Copiar a db/.env y poner una contraseña real:
#   openssl rand -base64 32
POSTGRES_DB=dermicapro
POSTGRES_USER=dermicapro
POSTGRES_PASSWORD=

# Días que se conservan los backups (scripts/db-backup.sh)
# BACKUP_KEEP_DAYS=14

# Camino para que n8n (que corre en otra VPS) alcance esta base.
#
# Debe ser la IP PRIVADA de este host, nunca 0.0.0.0: atado a todas las
# interfaces el puerto queda expuesto a Internet. Sin definir, PostgreSQL solo
# escucha en localhost y en la red de Docker.
#
# Averiguarla en el servidor con:  ip -4 addr show | grep "inet 10\.\|inet 172\.\|inet 192\.168\."
# POSTGRES_BIND_IP=10.0.0.5
# POSTGRES_PUBLISH_PORT=5432
