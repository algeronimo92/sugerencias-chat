# URL base del backend FastAPI
VITE_API_BASE_URL=http://localhost:8000

# WhatsApp Embedded Signup (coexistencia con la app de WhatsApp Business).
# App ID público de la app Tech Provider en Meta App Dashboard.
VITE_FACEBOOK_APP_ID=
# Configuration ID del flujo de Embedded Signup (WhatsApp → Embedded Signup
# en el dashboard de Meta), no confundir con el App ID.
VITE_FACEBOOK_CONFIG_ID=
