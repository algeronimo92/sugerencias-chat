    {
      "parameters": {
        "jsCode": "return $('Meta eventos (POST)').all().map((item, index) => {\n  let raw = null;\n  if (typeof item.json.rawBody === 'string') raw = item.json.rawBody;\n  else if (item.json.rawBody && item.json.rawBody.type === 'Buffer') raw = Buffer.from(item.json.rawBody.data).toString('utf8');\n  else if (item.binary && item.binary.data && item.binary.data.data) raw = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n  if (raw == null) throw new Error('Raw body no disponible: mantener Raw Body activo en el Webhook');\n  return { json: { ...item.json, raw_body: raw }, pairedItem: { item: index } };\n});"
      },
